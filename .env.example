# Copie para ".env" só para testar no seu computador. No Railway, cadastre estas variáveis na aba "Variables".
# Supabase > Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
GOOGLE_MAPS_API_KEY=
# Mercado Pago > Suas integrações > Credenciais de teste > Access Token (APP_USR-...)
MP_ACCESS_TOKEN=
# Resend > API Keys (re_...). Usado no "Esqueci minha senha". Pode ser a mesma conta Resend ligada ao Supabase.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend. Sem domínio, use onboarding@resend.dev (só entrega para o e-mail dono da conta Resend)
RESEND_FROM=Acesso+ <onboarding@resend.dev>
# Endereço público do site, usado no link do e-mail (ex: https://xxxx.up.railway.app)
SITE_URL=
